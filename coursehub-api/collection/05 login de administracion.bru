meta {
  name: 05 login de administración
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.accessToken);
}

tests {
  test("la cuenta de administración inicia sesión con rol admin", function () {
    expect(
      res.status,
      "Crea la cuenta admin y asígnale el rol con el SQL del README antes de ejecutar la colección",
    ).to.equal(200);
    expect(res.body.user.role).to.equal("admin");
  });
}
