meta {
  name: 03 lectura pública
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/courses?limit=5
  body: none
  auth: none
}

tests {
  test("responde la forma paginada documentada", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.meta).to.include.keys("total", "page", "limit", "totalPages");
  });
}
