meta {
  name: 07 lectura del curso creado
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/courses/{{courseId}}
  body: none
  auth: none
}

tests {
  test("el curso creado se lee con el mismo contrato", function () {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Curso de la colección");
    expect(res.body.level).to.equal("intermediate");
  });
}
